# Server-side evlog drain. Same phc_ project token as above; PostHog Logs
# authenticates with it, so it is not a secret.
# Use https://eu.i.posthog.com for PostHog EU.
NUXT_POSTHOG_API_KEY=
NUXT_POSTHOG_HOST=https://us.i.posthog.com
